DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# 테스트 서버 ID를 넣으면 /추가과제가 즉시 표시됨
DISCORD_GUILD_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=90
GEMINI_TOPIC_TIMEOUT_SECONDS=35
# gemini 또는 opencode
AGENT_BACKEND=opencode
# OpenCode API 사용 시
# sk-로 시작하는 OpenCode Go API 키를 넣으면 serve가 필요 없음
OPENCODE_API_KEY=sk-
OPENCODE_URL=http://host.docker.internal:4096
# OpenCode를 저장소 루트에서 실행하면 비워둠
OPENCODE_DIRECTORY=
# 예: provider/model
OPENCODE_MODEL=opencode-go/deepseek-v4-flash
# 쉼표로 OpenCode 모델 fallback 순서를 지정합니다.
OPENCODE_MODELS=opencode-go/deepseek-v4-flash,opencode-go/mimo-v2.5,opencode-go/mimo-v2.5-pro
OPENCODE_RETRIES=1
OPENCODE_FAILOVER_RETRY_DELAY_SECONDS=20
OPENCODE_FALLBACK_GEMINI=true
OPENCODE_TIMEOUT_SECONDS=120
OPENCODE_FAILOVER_RETRY_FAILOVER_EXHAUSTED=false
OPENCODE_REVIEW_TIMEOUT_SECONDS=45
REQUIRE_OPENCODE_BLUEPRINT_REVIEW=true
OUTPUT_DIR=/data/jobs
LOG_LEVEL=INFO
MAX_RETRIES=2
ALLOWED_CHANNEL_IDS=
